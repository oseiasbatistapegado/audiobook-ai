#!/usr/bin/env bash
use flake

source .venv/bin/activate

if [ -f .env ]; then
  dotenv .env
fi 

# ─── VRAM / GPU thresholds ───────────────────────────────────────────
# AUDIOBOOK_AI_HARD_FLOOR_MIB=300        # Mínimo livre VRAM antes de iniciar novo trabalho
# AUDIOBOOK_AI_BEFORE_CHUNK_TARGET_MIB=512  # Target VRAM livre antes de alocar SpeechChunk
# AUDIOBOOK_AI_TTS_BEFORE_LOAD_TARGET_MIB=3072  # VRAM livre para carregar Qwen3-TTS
# AUDIOBOOK_AI_PARLER_BEFORE_LOAD_MIB=4096  # VRAM livre para Parler-TTS voice design
# ─── TTS pipeline config ───────────────────────────────────────────
# AUDIOBOOK_AI_TTS_MAX_CHUNK_CHARS=5000    # Chars máx por chunk (mudança invalida resume)
# AUDIOBOOK_AI_TTS_CHUNKS_PER_WORKER=0     # Limit de chunks por worker (>0 habilita)
# AUDIOBOOK_AI_TTS_MULTI_WORKERS=2         # Workers paralelos TTS (1-4)
# AUDIOBOOK_AI_TTS_ASYNC_OVERLAP=1         # Overlap LLM→TTS (0=linear, 1=default)
# ─── ────────────────────────────────────────────────────────────────

echo "Environment configured for FIIS project using Nix"
